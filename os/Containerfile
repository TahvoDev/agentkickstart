# agentbox OS image (bootc).
#
# The host is deliberately tiny: podman + the systemd/quadlet plumbing. The
# XFCE desktop and the Agent Vault run as containers; the OS just orchestrates
# them. Build with the repo root as context:
#
#   podman build -f os/Containerfile -t ghcr.io/OWNER/agentbox-os:latest .
#
# Pinned to Fedora 44 by digest for reproducible builds; Renovate bumps it.
# The installer ISO uses the `bootc-generic-iso` type, which takes the kernel +
# EFI tree from the installer container in os/iso/ (not this image), so it
# builds on any host.
#
# The gate is a tiny static Go binary; bake it into the OS image rather than
# ship a third container image for it. It already ran with host networking and
# no meaningful isolation, so a container bought nothing.
FROM docker.io/library/golang:1.23-alpine AS gate-build
WORKDIR /src
COPY gate/go.mod gate/go.sum ./
RUN go mod download
COPY gate/*.go ./
RUN CGO_ENABLED=0 go build -trimpath -ldflags '-s -w' -o /out/agentbox-gate .

FROM quay.io/fedora/fedora-bootc:44@sha256:a2789aaa615504ac9dd039a6ac0cc75343ceca89416e38441d739dbffe6557c9

# The base already ships podman, nftables, jq, curl and openssh-server
# (verified on fc44). Add shim-x64/grub2-efi-x64: the installer ISO build
# (osbuild's grub2.iso stage) needs shim + grub EFI binaries.
RUN dnf -y install shim-x64 grub2-efi-x64 \
  && dnf -y clean all && rm -rf /var/cache/* /var/lib/dnf/* /run/dnf /var/log/dnf*.log

# Host payload, one source of truth per file (see os/system/): systemd units,
# quadlets, tmpfiles, the agentbox CLI, the egress deriver and the firewall.
COPY os/system/ /
# The baked-in gate (claim UI + vault proxy) and its QR helper.
COPY --from=gate-build /out/agentbox-gate /usr/libexec/agentbox/agentbox-gate
# The MCP config is also what agentbox-egress reads to learn which LAN hosts
# the containers may reach, so bake a copy on the host too.
COPY agent/opencode.json /usr/share/agentbox/opencode.json

# Point the agent quadlet at the real image (build.sh passes it). The checked-in
# value is a placeholder so a plain `podman build` stays valid.
ARG AGENT_IMAGE=ghcr.io/OWNER/agentbox-agent:latest
RUN sed -i "s|^Image=ghcr.io/OWNER/agentbox-agent:latest\$|Image=${AGENT_IMAGE}|" \
      /usr/share/containers/systemd/agentbox.container

RUN systemctl enable \
      agentbox-firewall.service agent-vault-init.service \
      agentbox-provision.service agentbox-selinux.service \
      agentbox-tailscale-serve.service agentbox-firstboot.service \
      agentbox-gate.service agentbox-setup-code.service \
      agentbox-claim-console.service agentbox-finalize.path \
      podman-auto-update.timer sshd.service \
 && systemctl mask sleep.target suspend.target hibernate.target hybrid-sleep.target

# bootc's static image checks; fails the build on problems.
RUN bootc container lint
