# Installer container for the `bootc-generic-iso` image type. image-builder
# takes the kernel and EFI tree from THIS container (not the build host), so
# the ISO builds anywhere with podman - no Fedora build host required.
# Pinned to Fedora 44 by digest; keep in sync with os/Containerfile.
FROM quay.io/fedora/fedora-bootc:44@sha256:2cdd9f75bdcfb2c0cbbd3c86942d3c1aef8ec0bd842e3fcdf884995887681f2e

ARG PAYLOAD_REF=ghcr.io/OWNER/agentbox-os:latest
RUN --mount=type=bind,source=os/iso,target=/src /src/build.sh "${PAYLOAD_REF}"
